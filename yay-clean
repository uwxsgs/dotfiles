#!/bin/bash

echo -e "\e[1;34m🧹 Starting Deep System Cleanup...\e[0m\n"

echo -e "\e[1;33m[1/6] Removing corrupted/interrupted downloads...\e[0m"
sudo rm -rf /var/cache/pacman/pkg/download-*
sudo rm -rf /var/cache/pacman/pkg/*.part 2>/dev/null
echo "✓ Done."

echo -e "\n\e[1;33m[2/6] Removing orphaned packages (unneeded dependencies)...\e[0m"
yay -Yc

echo -e "\n\e[1;33m[3/6] Cleaning package cache (pacman and yay)...\e[0m"
yay -Scc

echo -e "\n\e[1;33m[4/6] Cleaning old system logs (keeping only the last 50MB)...\e[0m"
sudo journalctl --vacuum-size=50M
echo "✓ Done."

echo -e "\n\e[1;33m[5/6] Cleaning unused Flatpak runtimes (if any)...\e[0m"
if command -v flatpak &> /dev/null; then
    flatpak uninstall --unused -y
else
    echo "Flatpak not installed. Skipping..."
fi
echo "✓ Done."

echo -e "\n\e[1;33m[6/6] Cleaning user application cache...\e[0m"
find ~/.cache -type f -atime +30 -delete 2>/dev/null
find ~/.config -name "*.bak" -type f -delete 2>/dev/null
find ~/.config -name "*~" -type f -delete 2>/dev/null
echo "✓ Done."

echo -e "\n\e[1;32m✨ System is officially squeaky clean!\e[0m\n"
